<div class="py-5" style="max-width:720px">
  <h1 class="h2 mb-2">Cadastrar animal</h1>
  <p class="text-body-secondary mb-4">Selecione o cliente dono do animal para criar o vínculo.</p>
  <% if (erro) { %><div class="alert alert-danger" role="alert"><%= erro %></div><% } %>
  <% if (!clientes.length) { %>
    <div class="alert alert-warning">
      Você precisa cadastrar um cliente antes de cadastrar um animal.
      <a href="/clientes/novo" class="alert-link">Cadastrar cliente</a>
    </div>
  <% } else { %>
    <form method="post" action="/animais/novo">
      <div class="mb-3">
        <label for="nome" class="form-label">Nome</label>
        <input id="nome" name="nome" class="form-control" maxlength="100" required value="<%= animal.nome || '' %>">
      </div>
      <div class="mb-3">
        <label for="raca" class="form-label">Raça</label>
        <input id="raca" name="raca" class="form-control" maxlength="100" required value="<%= animal.raca || '' %>">
      </div>
      <div class="row">
        <div class="col-md-6 mb-3">
          <label for="porte" class="form-label">Porte</label>
          <select id="porte" name="porte" class="form-select" required>
            <option value="">Selecione</option>
            <% ['Pequeno', 'Médio', 'Grande'].forEach(valor => { %>
              <option value="<%= valor %>" <%= animal.porte === valor ? 'selected' : '' %>><%= valor %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-6 mb-3">
          <label for="especie" class="form-label">Espécie</label>
          <input id="especie" name="especie" class="form-control" placeholder="Ex.: Gato, Cachorro" maxlength="50" required value="<%= animal.especie || '' %>">
        </div>
      </div>
      <div class="row">
        <div class="col-md-6 mb-3">
          <label for="sexo" class="form-label">Sexo</label>
          <select id="sexo" name="sexo" class="form-select" required>
            <option value="">Selecione</option>
            <% ['Macho', 'Fêmea'].forEach(valor => { %>
              <option value="<%= valor %>" <%= animal.sexo === valor ? 'selected' : '' %>><%= valor %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-6 mb-3">
          <label for="idade" class="form-label">Idade (anos)</label>
          <input id="idade" name="idade" class="form-control" type="number" min="0" step="1" required value="<%= animal.idade ?? '' %>">
        </div>
      </div>
      <div class="mb-4">
        <label for="clienteID" class="form-label">Dono do animal</label>
        <select id="clienteID" name="clienteID" class="form-select" required>
          <option value="">Selecione um cliente</option>
          <% clientes.forEach(cliente => { %>
            <option value="<%= cliente.clienteID %>" <%= Number(animal.clienteID) === cliente.clienteID ? 'selected' : '' %>>
              <%= cliente.nome %> (ID: <%= cliente.clienteID %>)
            </option>
          <% }) %>
        </select>
      </div>
      <button type="submit" class="btn btn-success">Salvar animal</button>
      <a href="/animais" class="btn btn-outline-secondary">Cancelar</a>
    </form>
  <% } %>
</div>
