<div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mt-5 mb-4">
  <div><h1 class="h2 mb-1">Clientes cadastrados</h1>
  <p class="text-body-secondary mb-0">Consulta dos donos dos animais.</p></div>
  <a href="/clientes/novo" class="btn btn-primary">+ Cadastrar cliente</a>
</div>
<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead><tr><th>ID</th><th>Nome</th><th>Telefone</th><th>CPF</th><th>Endereço</th></tr></thead>
    <tbody>
      <% if (!clientes.length) { %>
        <tr><td colspan="5" class="text-center py-4">Nenhum cliente cadastrado.</td></tr>
      <% } %>
      <% clientes.forEach(cliente => { %>
        <tr>
          <td><%= cliente.clienteID %></td>
          <td><%= cliente.nome %></td>
          <td><%= cliente.telefone || '-' %></td>
          <td><%= cliente.cpf %></td>
          <td><%= cliente.endereco || '-' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
